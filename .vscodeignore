# Source and dev tooling — esbuild bundles everything the extension needs
# into out/extension.js, so none of this is required at runtime.
src/**
node_modules/**
.vscode/**
.vscode-test/**
.github/**

# Packaged VSIX archive from past releases
dist/**

# Build / lint / test config and documentation not needed at runtime
config/**
docs/**
*.map

# Assets that aren't needed (SVG version is redundant with PNG)
assets/icon.svg

# Misc
.gitignore
.git/**
*.vsix
.mcp.json
.claude/
